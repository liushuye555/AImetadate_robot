    {
      "canonical": "虚拟卡",
      "kind": "concept",
      "definition": "非实体形式的支付卡或支付凭据；卡组织、发卡机构、开卡渠道和适用地区是不同信息。",
      "aliases": [
        {
          "text": "虚拟visa卡",
          "status": "conventional"
        },
        {
          "text": "虚拟 Visa 卡",
          "status": "conventional"
        },
        {
          "text": "虚拟信用卡",
          "status": "conventional"
        },
        {
          "text": "virtual card",
          "status": "standard"
        }
      ],
      "sources": [
        "https://www.visa.com/en-us/business/cards/virtual-card"
      ],
      "limits": "不能从Visa名称推断发卡平台、是否要人脸或地区可用性。",
      "definition_level": "reference"
    },
    {
      "canonical": "Visa",
      "kind": "concept",
      "definition": "支付网络或卡组织名称；也可能在英文中指签证，结合卡片/支付语境区分。",
      "aliases": [
        {
          "text": "visa卡",
          "status": "contextual",
          "requires_any": [
            "卡",
            "支付",
            "开卡"
          ]
        }
      ],
      "sources": [
        "https://usa.visa.com/about-visa.html"
      ],
      "limits": "不能把所有Visa卡当成同一发卡产品。",
      "definition_level": "reference"
    },
    {
      "canonical": "API接入",
      "kind": "concept",
      "definition": "通过程序接口访问服务；网页客户端、官方接口和第三方兼容接口可分别存在。",
      "aliases": [
        {
          "text": "API",
          "status": "standard"
        },
        {
          "text": "接口调用",
          "status": "conventional"
        },
        {
          "text": "API key",
          "status": "standard"
        }
      ],
      "sources": [
        "https://developer.mozilla.org/en-US/docs/Glossary/API"
      ],
      "limits": "知道客户端名称不代表知道实际供应商或请求路由；不得输出真实凭据。",
      "definition_level": "reference"
    },
    {
      "canonical": "接口中转",
      "kind": "concept",
      "definition": "请求经第三方服务转发或适配；兼容某接口格式不证明是该品牌官方服务。",
      "aliases": [
        {
          "text": "中转站",
          "status": "contextual",
          "requires_any": [
            "API",
            "接口",
            "模型",
            "key"
          ]
        },
        {
          "text": "反代",
          "status": "contextual",
          "requires_any": [
            "API",
            "接口",
            "服务",
            "请求"
          ]
        }
      ],
      "sources": [
        "https://developer.mozilla.org/en-US/docs/Glossary/Proxy_server"
      ],
      "limits": "中转的经营方、上游、价格与稳定性需原文或独立核验。",
      "definition_level": "reference"
    },
    {
      "canonical": "邮箱别名",
      "kind": "concept",
      "definition": "可投递到既有收件箱的其他邮箱地址形式，具体行为取决于服务商。",
      "aliases": [
        {
          "text": "邮箱alias",
          "status": "conventional"
        },
        {
          "text": "邮件别名",
          "status": "conventional"
