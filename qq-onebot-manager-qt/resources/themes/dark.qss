* { font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif; font-size: 13px; }
QMainWindow, QWidget#content {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #16161c, stop:0.55 #181521, stop:1 #151823);
}
QWidget { color: #e8e9f0; }
QToolTip { background: #22232b; color: #e8e9f0; border: 1px solid #3a2b35; border-radius: 6px; padding: 5px 9px; }

/* 侧边导航 */
QFrame#brand { background: transparent; border-bottom: 1px solid #26222e; }
QLabel#brandName { color: #f2f2f8; font-size: 15px; font-weight: 700; }
QLabel#brandSub { color: #c86da2; font-size: 11px; }
QListWidget#nav { background: transparent; border: none; outline: 0; padding-top: 6px; }
QListWidget#nav::item { color: #9a95a8; padding: 10px 14px; margin: 3px 12px; border-radius: 10px; border: 1px solid transparent; }
QListWidget#nav::item:hover { background: #262031; color: #e3aecb; }
QListWidget#nav::item:selected { background: #3a2133; color: #ff7ab8; border: 1px solid #55304a; font-weight: 600; }
QListWidget#nav::item:selected:hover { background: #3a2133; }

/* 侧栏底部操作区 */
QFrame#sidebarActions { background: transparent; border-top: 1px solid #26222e; }
QPushButton#themeButton, QPushButton#quitButton {
    padding: 9px 14px; border-radius: 12px; border: 1px solid #3a2b35;
    background: #221c28; color: #f472b6; font-weight: 600; text-align: center;
}
QPushButton#themeButton:hover, QPushButton#quitButton:hover { background: #2e2130; border-color: #59364c; }

/* 二级导航（设置页子菜单） */
QListWidget#subnav { background: rgba(255,255,255,0.03); border: none; border-right: 1px solid #26222e; outline: 0; padding-top: 8px; border-radius: 0; }
QListWidget#subnav::item { color: #9a95a8; padding: 8px 14px; margin: 1px 8px; border-radius: 8px; }
QListWidget#subnav::item:hover { background: #262031; }
QListWidget#subnav::item:selected { background: #3a2133; color: #ff7ab8; }
QListWidget#subnav::item:selected:hover { background: #3a2133; }

/* 悬浮顶栏 */
QFrame#pageHeader {
    background: rgba(32,30,40,0.72); border: 1px solid #2c2836; border-radius: 14px;
    margin: 14px 20px 0;
}
QLabel#pageTitle { font-size: 20px; font-weight: 700; color: #f2f2f8; }
QLabel#pageSubtitle { font-size: 12.5px; color: #9a95a8; }

/* 卡片 */
QFrame#card { background: rgba(33,32,41,0.88); border: 1px solid #2c2836; border-radius: 14px; }
QFrame#card:hover { border-color: #47364a; }
QLabel#sectionTitle { font-size: 12.5px; font-weight: 700; color: #c86da2; letter-spacing: 1px; }
QLabel#infoLine { color: #c6c3d2; }
QLabel#cardTitle { font-size: 12.5px; font-weight: 600; color: #9a95a8; }
QLabel#cardValue { font-size: 16px; font-weight: 650; color: #f2f2f8; }
QLabel#cardValue[state="ok"] { color: #45d68e; }
QLabel#cardValue[state="bad"] { color: #ff7287; }
QLabel#cardIcon { background: rgba(235,47,150,0.13); border-radius: 9px; }
QLabel#statusDot { background: #464253; border-radius: 4px; }
QLabel#statusDot[state="ok"] { background: #34c981; }
QLabel#statusDot[state="bad"] { background: #ef5f78; }
QLabel#muted { color: #9a95a8; font-size: 12px; }

/* 按钮 */
QPushButton { padding: 7px 16px; border-radius: 10px; border: 1px solid #35323f; background: #232129; color: #e2e0ea; }
QPushButton:hover { background: #2b2733; border-color: #4a4054; }
QPushButton:pressed { background: #1c1a22; }
QPushButton:disabled { color: #5f5a6a; background: #1d1b23; border-color: #2a2733; }
QPushButton#primary { background: #eb2f96; color: white; border: none; font-weight: 600; }
QPushButton#primary:hover { background: #f050a8; }
QPushButton#primary:pressed { background: #d62387; }
QPushButton#primary:disabled { background: #6e2848; color: #caa; }
QPushButton#danger { background: #e5484d; color: white; border: none; font-weight: 600; }
QPushButton#danger:hover { background: #ec5a5f; }
QPushButton#danger:disabled { background: #5e2c30; color: #caa6a9; }

/* 输入控件 */
QLineEdit, QPlainTextEdit, QComboBox, QSpinBox {
    border: 1px solid #35323f; border-radius: 10px; padding: 6px 10px; background: #1b1a21; color: #e8e9f0;
    selection-background-color: #eb2f96;
}
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #eb2f96; }
QLineEdit.invalid { border: 1px solid #e5484d; background: #2a1b20; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView { border: 1px solid #35323f; background: #1b1a21; selection-background-color: #eb2f96; selection-color: white; border-radius: 8px; }
QSpinBox::up-button, QSpinBox::down-button { border: none; background: transparent; width: 16px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: #2b2733; border-radius: 3px; }

/* 复选框 */
QCheckBox, QRadioButton { spacing: 7px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; border: 1.5px solid #4a4054; background: #1b1a21; }
QCheckBox::indicator { border-radius: 5px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #eb2f96; }
QCheckBox::indicator:checked { background: #eb2f96; border-color: #eb2f96; image: url(:/icons/check-white.svg); }
QRadioButton::indicator:checked { background: #eb2f96; border-color: #eb2f96; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background: #1d1b23; border-color: #2c2836; }

/* 分区卡片 */
QGroupBox { border: 1px solid #2c2836; border-radius: 14px; margin-top: 14px; background: rgba(33,32,41,0.88); font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 8px 6px 0; color: #e58ab8; font-weight: 700; font-size: 14px; }

/* 列表 */
QListWidget { border: 1px solid #2c2836; border-radius: 10px; background: #1b1a21; outline: 0; }
QListWidget::item { padding: 8px 10px; border-radius: 8px; }
QListWidget::item:selected { background: #3a2133; color: #ff9ec9; }

/* 滚动条 */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #3b3645; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #4c4558; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #3b3645; border-radius: 5px; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* 日志字体 */
QPlainTextEdit#logView { font-family: Consolas, "Courier New", monospace; font-size: 12px; }

/* 对话框 */
QDialog { background: #17161d; }
QMenu { background: #212029; border: 1px solid #35323f; border-radius: 10px; padding: 6px; }
QMenu::item { padding: 7px 22px 7px 14px; border-radius: 8px; }
QMenu::item:selected { background: #3a2133; color: #ff9ec9; }
QMenu::separator { height: 1px; background: #2c2836; margin: 5px 8px; }

/* 滚动区透明，透出背景渐变 */
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }

/* 概览统计卡与提示条 */
QLabel#statValue { font-size: 24px; font-weight: 700; color: #f2f2f8; }
QLabel#statCaption { font-size: 12px; color: #9a95a8; }
QLabel#infoLine { color: #8b8798; font-size: 12px; }
QLabel#hintBar { background: rgba(229,72,77,0.16); border: 1px solid rgba(229,72,77,0.40); border-radius: 10px; padding: 10px 14px; color: #ff97a6; }

/* 设置页表单限宽 */
SettingsPage QLineEdit, SettingsPage QComboBox, SettingsPage QSpinBox { max-width: 460px; }

/* 群列表（原版 QQ 风两行条目） */
QListWidget#groupList::item { padding: 4px 8px; }
QListWidget#groupList::item:hover { background: #262031; }
QListWidget#groupList::item:selected { background: #3a2133; }
QLabel#rowName { font-size: 13px; font-weight: 600; color: #e8e6f0; }
QLabel#rowSummary { font-size: 11px; color: #9a95a8; }
