# Copy to .env and fill values to enable ds v4 flash summaries.
# Do NOT commit or share .env.
# Optional OneBot v11 Bearer token; must match the selected framework.
set "ONEBOT_ACCESS_TOKEN="
# QQ Open Platform: can also be saved from the manager's masked AppSecret field.
set "QQBOT_APP_SECRET="
set "SNOWLUMA_ONEBOT_TOKEN="
set "DS_V4_FLASH_BASE_URL=https://your-openai-compatible-endpoint/v1"
set "DS_V4_FLASH_API_KEY=your_api_key_here"
set "DS_V4_FLASH_MODEL=deepseek-flash"
